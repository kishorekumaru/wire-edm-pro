---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbList } from "../lib/breadcrumbs";
import CtaBand from "../components/CtaBand.astro";
import { industries } from "../data/industries";

const icon = (slug: string) => industries.find((i) => i.slug === slug)?.icon ?? "";
const trio = [
  {
    href: "/industries/tool-die-making/",
    icon: icon("tool-die-making"),
    name: "Manufacturing",
    body: "Press tools, dies and fixtures. The tooling their tooling depends on.",
  },
  {
    href: "/industries/mining/",
    icon: icon("mining"),
    name: "Mining",
    body: "Hardened wear parts and drive components that can't wait months for OEM spares.",
  },
  {
    href: "/industries/medical/",
    icon: icon("medical"),
    name: "Medical",
    body: "Small stainless and titanium components where burr-free edges are not negotiable.",
  },
];

const breadcrumbs = breadcrumbList([{ name: "About us", href: "/about/" }], Astro.site);
---
<BaseLayout
  title="About Wire EDM Pro | Precision Machining, Sydney"
  description="Precision machining in Sydney since the early 2000s: EDM wire cutting, EDM drilling, CNC milling and turning for defence, medical, mining and engineering."
  jsonLd={breadcrumbs}
>
  <section class="about-hero section--tight">
    <div class="about-hero__bg">
      <picture>
              <source srcset="/images/building-exterior-800.webp 800w, /images/building-exterior.webp 1600w" sizes="(max-width: 56rem) 100vw, 62vw" type="image/webp" />
              <img
        src="/images/building-exterior.jpg"
        srcset="/images/building-exterior-800.jpg 800w, /images/building-exterior.jpg 1600w"
        sizes="(max-width: 56rem) 100vw, 62vw"
        width="1600" height="900"
        alt="The Wire EDM Pro premises at Kings Park, Sydney"
        fetchpriority="high"
      />
            </picture>
    </div>
    <div class="container about-hero__copy">
      <p class="about-hero__kicker mono">About us</p>
      <h1>Who we are.</h1>
      <p class="about-hero__lede">
        Wire EDM Pro is a Sydney-based precision engineering company with over 25 years of
        experience supporting the Australian manufacturing industry. Since the early 2000s,
        we have grown into a trusted partner for manufacturers across defence, aerospace,
        medical, mining, automotive, robotics, electrical and general engineering sectors.
        Our foundation is built on precision, reliability, craftsmanship and integrity:
        values that continue to guide us as we help bring Australian manufacturing back
        to its golden era.
      </p>
    </div>
  </section>

  <section class="section section--panel purpose">
    <div class="container purpose__grid">
      <div>
        <h2>Our purpose &amp; vision.</h2>
        <p class="purpose__body">
          Our purpose is simple, powerful and deeply rooted in national pride:
          &ldquo;Make Australian Manufacturing Great Again.&rdquo; We believe Australia
          deserves a strong, competitive, world-class manufacturing sector. Every tool we
          build, every component we machine and every project we deliver strengthens local
          industry and reduces dependence on overseas production.
        </p>
        <div class="purpose__values">
          <div>
            <h3>Purpose</h3>
            <p>We understand the evolving needs of modern industry, and we are committed to delivering solutions that help Australian manufacturers innovate, grow and compete globally.</p>
          </div>
          <div>
            <h3>Vision</h3>
            <p>To keep steady and strong, continually serving the industry while building new partnerships and industrial collaborations across sectors. By combining experience, technology and trust, we look forward to a future where Australian manufacturing leads the world once again.</p>
          </div>
        </div>
      </div>
      <div class="purpose__photos">
        <picture>
              <source srcset="/images/wire-edm-office-800.webp 800w, /images/wire-edm-office.webp 1600w" sizes="(max-width: 56rem) 100vw, 40vw" type="image/webp" />
              <img
          class="photo purpose__photo-main"
          src="/images/wire-edm-office-800.jpg"
          srcset="/images/wire-edm-office-800.jpg 800w, /images/wire-edm-office.jpg 1600w"
          sizes="(max-width: 56rem) 100vw, 40vw"
          width="800" height="450"
          alt="Inside Wire EDM Pro in Sydney"
          loading="lazy"
        />
            </picture>
      </div>
    </div>
  </section>

  <section class="section creed">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Our working values.</h2>
        <p>They shape the way we work, the way we serve, and the way we build long-term relationships with our customers.</p>
      </div>
      <div class="creed__values">
        <div class="creed__value creed__value--lead" data-reveal style="--reveal-i: 0">
          <h3>Customer first. Always.</h3>
          <blockquote class="creed__quote">
            <p>
              &ldquo;A customer is the most important visitor on our premises... He is not
              dependent on us. We are dependent on him.&rdquo;
            </p>
            <footer>- Mahatma Gandhi</footer>
          </blockquote>
          <p>
            This principle guides every decision we make. To us, the customer is everything:
            the reason we exist, the reason we improve, and the reason we continue to innovate.
          </p>
        </div>
        <div class="creed__value" data-reveal style="--reveal-i: 1">
          <h3>Precision is our identity</h3>
          <p>
            As toolmakers, we understand that every micron matters. Accuracy, consistency and
            craftsmanship are not just goals; they are our identity.
          </p>
        </div>
        <div class="creed__value" data-reveal style="--reveal-i: 2">
          <h3>Integrity &amp; Trust</h3>
          <p>
            We protect your intellectual property with strict confidentiality. Design secrets,
            technical drawings and patented concepts are handled with absolute care and respect.
          </p>
        </div>
        <div class="creed__value" data-reveal style="--reveal-i: 3">
          <h3>On-time delivery</h3>
          <p>
            Industry runs on deadlines. We deliver on time, every time, without compromising
            quality.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section machines">
    <div class="container">
      <div class="section-head">
        <h2>The machines on the floor.</h2>
        <p>Wire EDM is the core of the business; milling and turning carry the work that surrounds it.</p>
      </div>
      <div class="machines__list">
        <figure class="machines__row" data-reveal>
          <div class="machines__frame"><div class="machines__media">
            <picture>
              <source srcset="/images/makino-square-800.webp 800w, /images/makino-square.webp 1600w" sizes="(max-width: 56rem) 100vw, 62vw" type="image/webp" />
              <img
              src="/images/makino-square.jpg"
              srcset="/images/makino-square-800.jpg 800w, /images/makino-square.jpg 1600w"
              sizes="(max-width: 56rem) 100vw, 62vw"
              width="1600" height="900"
              alt="Makino wire EDM machine"
              loading="lazy"
            />
            </picture>
          </div></div>
          <figcaption>
            <span class="machines__tag mono">M-01</span>
            <b>Makino wire EDM</b>
            <span>H.E.A.T technology cuts jobs up to 420&nbsp;mm tall. Fine-finish wire cutting where surface and edge quality decide the job.</span>
          </figcaption>
        </figure>
        <figure class="machines__row" data-reveal>
          <div class="machines__frame"><div class="machines__media">
            <picture>
              <source srcset="/images/fanuc-c600ia-800.webp 800w, /images/fanuc-c600ia.webp 1600w" sizes="(max-width: 56rem) 100vw, 62vw" type="image/webp" />
              <img
              src="/images/fanuc-c600ia.jpg"
              srcset="/images/fanuc-c600ia-800.jpg 800w, /images/fanuc-c600ia.jpg 1600w"
              sizes="(max-width: 56rem) 100vw, 62vw"
              width="1600" height="900"
              alt="Fanuc RoboCut C600 wire EDM machine"
              loading="lazy"
            />
            </picture>
          </div></div>
          <figcaption>
            <span class="machines__tag mono">M-02</span>
            <b>Fanuc RoboCut C600</b>
            <span>High-reliability, large-capacity precision wire cutting. The production workhorse for big dies, plates and matched sets.</span>
          </figcaption>
        </figure>
        <figure class="machines__row" data-reveal>
          <div class="machines__frame"><div class="machines__media">
            <picture>
              <source srcset="/images/fanuc-robocut-0id-800.webp 800w, /images/fanuc-robocut-0id.webp 1600w" sizes="(max-width: 56rem) 100vw, 62vw" type="image/webp" />
              <img
              src="/images/fanuc-robocut-0id.jpg"
              srcset="/images/fanuc-robocut-0id-800.jpg 800w, /images/fanuc-robocut-0id.jpg 1600w"
              sizes="(max-width: 56rem) 100vw, 62vw"
              width="1600" height="900"
              alt="Fanuc RoboCut C400 wire EDM machine"
              loading="lazy"
            />
            </picture>
          </div></div>
          <figcaption>
            <span class="machines__tag mono">M-03</span>
            <b>Fanuc RoboCut C400</b>
            <span>High-speed, high-accuracy compact wire cutting. Fine profiles, small components and quick turnarounds.</span>
          </figcaption>
        </figure>
        <figure class="machines__row" data-reveal>
          <div class="machines__frame"><div class="machines__media">
            <picture>
              <source srcset="/images/ecomill-600v-800.webp 800w, /images/ecomill-600v.webp 1600w" sizes="(max-width: 56rem) 100vw, 62vw" type="image/webp" />
              <img
              src="/images/ecomill-600v.jpg"
              srcset="/images/ecomill-600v-800.jpg 800w, /images/ecomill-600v.jpg 1600w"
              sizes="(max-width: 56rem) 100vw, 62vw"
              width="1600" height="900"
              alt="DMG MORI ecoMill 600 V vertical machining centre"
              loading="lazy"
            />
            </picture>
          </div></div>
          <figcaption>
            <span class="machines__tag mono">M-04</span>
            <b>DMG MORI ecoMill 600&nbsp;V</b>
            <span>Vertical machining centre. 12,000&nbsp;rpm spindle and a 600&nbsp;kg table for the jigs, fixtures, die sets and spares around the EDM work.</span>
          </figcaption>
        </figure>
        <figure class="machines__row" data-reveal>
          <div class="machines__frame"><div class="machines__media">
            <picture>
              <source srcset="/images/edm-drilling-800.webp 800w, /images/edm-drilling.webp 1600w" sizes="(max-width: 56rem) 100vw, 62vw" type="image/webp" />
              <img
              src="/images/edm-drilling.jpg"
              srcset="/images/edm-drilling-800.jpg 800w, /images/edm-drilling.jpg 1600w"
              sizes="(max-width: 56rem) 100vw, 62vw"
              width="1600" height="900"
              alt="EDM drilling machine"
              loading="lazy"
            />
            </picture>
          </div></div>
          <figcaption>
            <span class="machines__tag mono">M-05</span>
            <b>EDM drills</b>
            <span>Fast micro-hole drilling from Ø&nbsp;0.3&nbsp;mm to 3.0&nbsp;mm. Start holes, cooling channels and vents through hardened metal.</span>
          </figcaption>
        </figure>
        <figure class="machines__row" data-reveal>
          <div class="machines__frame"><div class="machines__media">
            <picture>
              <source srcset="/images/cnc-turning-800.webp 800w, /images/cnc-turning.webp 1600w" sizes="(max-width: 56rem) 100vw, 62vw" type="image/webp" />
              <img
              src="/images/cnc-turning.jpg"
              srcset="/images/cnc-turning-800.jpg 800w, /images/cnc-turning.jpg 1600w"
              sizes="(max-width: 56rem) 100vw, 62vw"
              width="1600" height="900"
              alt="CNC lathe turning a steel shaft"
              loading="lazy"
            />
            </picture>
          </div></div>
          <figcaption>
            <span class="machines__tag mono">M-06</span>
            <b>CNC lathes &amp; laser</b>
            <span>Turning and profile cutting. Shafts, bushes, pins and threads to gauge, plus laser-cut sheet metal profiles.</span>
          </figcaption>
        </figure>
        <figure class="machines__row" data-reveal>
          <div class="machines__frame"><div class="machines__media">
            <picture>
              <source srcset="/images/qc-wireedm-800.webp 800w, /images/qc-wireedm.webp 1600w" sizes="(max-width: 56rem) 100vw, 62vw" type="image/webp" />
              <img
              src="/images/qc-wireedm.jpg"
              srcset="/images/qc-wireedm-800.jpg 800w, /images/qc-wireedm.jpg 1600w"
              sizes="(max-width: 56rem) 100vw, 62vw"
              width="1600" height="900"
              alt="Starrett optical profile projector in the inspection area"
              loading="lazy"
            />
            </picture>
          </div></div>
          <figcaption>
            <span class="machines__tag mono">M-07</span>
            <b>Quality control</b>
            <span>Optical profile projectors and calibrated metrology instruments. Every job checked against its approved design before delivery.</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--panel holeblow">
    <div class="container holeblow__grid" data-reveal>
      <div>
        <p class="holeblow__kicker mono">Small hole EDM</p>
        <h2>Hole blowing.</h2>
      </div>
      <div>
        <p class="holeblow__body">
          Alongside the wire machines sit our EDM drills. The trade calls it hole blowing:
          spark-eroding small holes from Ø&nbsp;0.3&nbsp;mm to 3.0&nbsp;mm straight through fully
          hardened metal. Start holes for wire threading, cooling channels and vents in tooling,
          drilled burr-free after heat treatment.
          <a href="/edm-drills/">See the EDM Drills capability</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="section trio">
    <div class="container">
      <h2>Three industries, one habit.</h2>
      <div class="trio__grid">
        {trio.map((t, i) => (
          <a class="trio__card" href={t.href} data-reveal style={`--reveal-i: ${i}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={t.icon} />
            <h3>{t.name}</h3>
            <p>{t.body}</p>
          </a>
        ))}
      </div>
      <p class="trio__habit" data-reveal>
        The habit that keeps them coming back is the same one we started with in the early
        2000s: say what we can hold, hold it, and hand the part over when we said we would.
        Most of our work arrives from customers who have been sending drawings for a decade or more.
      </p>
    </div>
  </section>

  <CtaBand
    heading="Put us to work."
    body="Send a drawing, a STEP file or a photo of the worn part. We'll reply within one business day."
  />
</BaseLayout>

<script>
  // Parallax drift on the machine photos while scrolling (mirrors the landing page)
  const imgs = Array.from(document.querySelectorAll(".machines__media img"));
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (imgs.length && !still) {
    let raf = 0;
    const update = () => {
      raf = 0;
      const vh = window.innerHeight;
      // Reads first, writes after (avoids per-image forced reflows); the imgs
      // sit inside <picture> wrappers, so the sized container needs closest()
      const writes: Array<[HTMLElement, string]> = [];
      for (const img of imgs) {
        const host = (img as HTMLElement).closest(".machines__media");
        if (!host) continue;
        const r = host.getBoundingClientRect();
        if (r.bottom < -120 || r.top > vh + 120) continue;
        const progress = (r.top + r.height / 2 - vh / 2) / vh;
        writes.push([img as HTMLElement, `${(progress * -34).toFixed(1)}px`]);
      }
      for (const [el, py] of writes) el.style.setProperty("--py", py);
    };
    window.addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    window.addEventListener("resize", () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
    update();
  }
</script>

<style>
  .about-hero {
    padding-block: var(--space-2xl) var(--space-2xl);
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
  }
  /* Office photo bleeds in from the right and dissolves before the copy */
  .about-hero__bg {
    position: absolute;
    inset: 0 0 0 auto;
    width: 62%;
  }
  .about-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to left, rgb(0 0 0) 42%, transparent 97%);
    mask-image: linear-gradient(to left, rgb(0 0 0) 42%, transparent 97%);
  }
  .about-hero__copy { position: relative; }
  .about-hero__kicker {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }
  .about-hero h1 { font-size: var(--text-display-s); max-width: 22ch; }
  .about-hero__lede {
    margin-top: var(--space-lg);
    font-size: var(--text-md);
    color: var(--color-muted);
    max-width: 58ch;
  }

  .purpose__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .purpose h2 { font-size: var(--text-xl); max-width: 24ch; }
  .purpose__body { margin-top: var(--space-lg); color: var(--color-muted); max-width: 56ch; }
  .purpose__values {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }
  .purpose__values h3 { font-size: var(--text-base); }
  .purpose__values p { margin-top: var(--space-xs); font-size: var(--text-sm); color: var(--color-muted); }
  .purpose__photos { position: relative; display: grid; }
  .purpose__photo-main { aspect-ratio: 16 / 11; }
  .purpose__photo-offset {
    width: 55%;
    aspect-ratio: 4 / 3;
    justify-self: end;
    margin-top: calc(var(--space-2xl) * -1);
    margin-right: calc(var(--space-xl) * -0.5);
    box-shadow: 0 1px 2px oklch(20% 0.01 251 / 0.08);
  }

  /* Working values (client copy): the customer-first value leads with the
     Gandhi quote in a tall featured cell; the other three stack beside it */
  .creed { background: var(--color-surface); }
  .creed__values {
    margin-top: var(--space-2xl);
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-xl) var(--space-2xl);
  }
  .creed__value--lead { grid-row: 1 / 4; }
  .creed__value--lead h3 { font-size: var(--text-lg); }
  .creed__quote {
    margin: var(--space-lg) 0 0;
    padding-left: var(--space-lg);
    border-left: 4px solid var(--color-accent-2);
  }
  .creed__quote p {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    line-height: 1.35;
    color: var(--color-ink);
    max-width: 30ch;
  }
  .creed__quote footer {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .creed__value {
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-rule);
    position: relative;
  }
  .creed__value::before {
    content: "";
    position: absolute;
    top: -2px;
    left: 0;
    width: 2rem;
    height: 2px;
    background: var(--color-accent-bright);
  }
  .creed__value h3 { font-size: var(--text-md); }
  .creed__value p { margin-top: var(--space-sm); color: var(--color-muted); }
  @media (max-width: 56rem) {
    .creed__values { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .creed__value--lead { grid-row: auto; }
    .about-hero__bg { width: 100%; opacity: 0.22; }
  }

  /* Machines: wide photo rows with a caption plate overlapping the image,
     plate side alternating row by row. Platinum band separates it from the
     white values section above */
  .machines { background: var(--color-paper-2); }
  .machines__list { display: grid; gap: var(--space-xl); }
  .machines__row {
    position: relative;
    margin: 0;
    display: grid;
  }
  .machines__frame {
    position: relative;
    width: 46%;
  }
  /* Blueprint offset frame behind each photo */
  .machines__frame::before {
    content: "";
    position: absolute;
    inset: 0.8rem -0.8rem -0.8rem 0.8rem;
    border: 1.5px solid var(--color-accent-soft);
    border-radius: var(--radius-md);
  }
  .machines__row:nth-child(even) .machines__frame::before {
    inset: 0.8rem 0.8rem -0.8rem -0.8rem;
  }
  .machines__media {
    position: relative;
    aspect-ratio: 16 / 8;
    overflow: hidden; /* masks the parallax drift */
    border-radius: var(--radius-md);
    border: var(--rule-hairline);
  }
  .machines__media img {
    width: 100%;
    height: 122%;
    margin-top: -11%;
    object-fit: cover;
    will-change: transform;
    /* No transition: easing toward per-frame --py targets rubber-bands on
       mobile momentum scroll */
    transform: translate3d(0, var(--py, 0px), 0);
  }
  @media (prefers-reduced-motion: reduce) {
    .machines__media img { will-change: auto; height: 100%; margin-top: 0; transform: none; }
  }
  .machines__row figcaption {
    position: absolute;
    bottom: var(--space-lg);
    right: 0;
    width: min(22rem, 38%);
    background: #ffffff;
    border: var(--rule-hairline);
    border-left: 4px solid var(--color-accent);
    padding: var(--space-lg) var(--space-xl);
    display: grid;
    gap: var(--space-2xs);
    box-shadow: 0 18px 36px -24px oklch(25% 0.06 267 / 0.5);
  }
  /* Dashed leader line from the plate to its machine, node dot at the far end */
  .machines__row figcaption::before {
    content: "";
    position: absolute;
    top: 50%;
    right: 100%;
    width: 4.5rem;
    border-top: 2px dashed var(--color-accent-bright);
  }
  .machines__row figcaption::after {
    content: "";
    position: absolute;
    top: 50%;
    right: calc(100% + 4.5rem);
    width: 10px;
    height: 10px;
    margin-top: -5px;
    border-radius: 999px;
    background: var(--color-accent-bright);
    box-shadow: 0 0 0 4px oklch(65% 0.079 238.8 / 0.25);
  }
  .machines__row:nth-child(even) figcaption::before { right: auto; left: 100%; }
  .machines__row:nth-child(even) figcaption::after { right: auto; left: calc(100% + 4.5rem); }
  .machines__tag {
    font-size: var(--text-sm);
    color: var(--color-accent);
    letter-spacing: 0.08em;
  }
  .machines__row:nth-child(even) .machines__frame { justify-self: end; }
  .machines__row:nth-child(even) figcaption {
    right: auto;
    left: 0;
    border-left: none;
    border-right: 4px solid var(--color-accent);
  }
  .machines__row b { font-family: var(--font-display); font-size: var(--text-md); }
  .machines__row figcaption span { font-size: var(--text-sm); color: var(--color-muted); }

  /* Hole blowing: compact two-column band for the small hole EDM capability */
  .holeblow__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  .holeblow__kicker {
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
