---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactEmail = "wireedmpro@gmail.com";
---
<BaseLayout
  title="Contact Wire EDM Pro | Quotes & Enquiries, Sydney"
  description="Get a machining quote from Wire EDM Pro in Sydney. Call or email a drawing, STEP file or sketch for EDM wire cutting, CNC milling, turning or reverse engineering."
>
  <section class="contact section--tight">
    <div class="container">
      <h1>Send us the job.</h1>
      <p class="contact__lede">
        A drawing, a STEP file, a photo of a worn part. Whatever you have, call or email it
        through. We quote from real information, so the price we give is the price you pay.
      </p>

      <div class="contact__grid">
        <div class="contact__info" data-reveal>
          <dl class="contact__details">
            <div>
              <dt>Address</dt>
              <dd>16/24 Garling Rd, Kings Park NSW 2148</dd>
            </div>
            <div>
              <dt>Landline</dt>
              <dd><a href="tel:+61286048347" class="mono">02 8604 8347</a></dd>
            </div>
            <div>
              <dt>Mobile</dt>
              <dd><a href="tel:+61452558052" class="mono">0452 558 052</a></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${contactEmail}`}>{contactEmail}</a></dd>
            </div>
            <div>
              <dt>Hours</dt>
              <dd>Monday–Thursday, 8:00&nbsp;am – 4:30&nbsp;pm<br />Friday, 8:00&nbsp;am – 12:00&nbsp;pm</dd>
            </div>
          </dl>
          <div class="contact__actions">
            <a class="btn btn--fill" href={`mailto:${contactEmail}?subject=Machining%20enquiry`}>Email your drawing</a>
            <a class="btn btn--outline" href="tel:+61286048347">Call us</a>
          </div>
        </div>

        <figure class="contact__photo" data-reveal style="--reveal-i: 1">
          <img
            class="photo"
            src="/images/building-exterior-800.jpg"
            srcset="/images/building-exterior-800.jpg 800w, /images/building-exterior.jpg 1600w"
            sizes="(max-width: 56rem) 100vw, 50vw"
            width="800" height="450"
            alt="The Wire EDM Pro premises in Sydney. Unit 16, with signage above the roller door"
            loading="lazy"
          />
          <figcaption>16/24 Garling Rd, Kings Park NSW 2148</figcaption>
        </figure>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { padding-block: var(--space-2xl) var(--space-3xl); }
  .contact h1 { font-size: var(--text-display-s); }
  .contact__lede {
    margin-top: var(--space-md);
    font-size: var(--text-md);
    color: var(--color-muted);
    max-width: 54ch;
  }
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-2xl);
    margin-top: var(--space-2xl);
    align-items: start;
  }
  .contact__details {
    margin: 0;
    display: grid;
    gap: var(--space-md);
  }
  .contact__details dt {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .contact__details dd {
    margin: var(--space-2xs) 0 0;
    font-weight: 500;
  }
  .contact__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }
  .contact__photo { margin: 0; }
  .contact__photo img { aspect-ratio: 16 / 10; }
  .contact__photo figcaption {
    margin-top: var(--space-xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  @media (max-width: 56rem) {
    .contact__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
  }
</style>
