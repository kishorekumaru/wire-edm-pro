---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";

// Equipment list confirmed by the client content doc (docs/WIRE EDM PRO-WEB CONTENT.pdf).
const equipment = [
  { name: "Optical profile projectors", verifies: "Non-contact measurement of intricate profiles, thread forms and sharp edges at magnification" },
  { name: "Digital micrometers", verifies: "Calibrated measurement of diameters and thicknesses to the micron" },
  { name: "Vernier calipers", verifies: "General dimensional checks across every stage of production" },
  { name: "Height gauges", verifies: "Datum-referenced heights, steps and depths" },
  { name: "Bore gauges", verifies: "Internal diameters held to exact tolerance" },
];

const checks = [
  { name: "First-article inspection", body: "The very first part off the machine is verified against the approved design before the production run starts. If the first article is wrong, nothing else gets cut." },
  { name: "Every critical dimension", body: "Every critical dimension is measured against the approved design before a part leaves. Not a sample. Every critical dimension." },
  { name: "Batch inspection", body: "Every production run gets systematic batch checks through to final packaging, so parts arrive consistent, defect-free and ready to assemble." },
];
---
<BaseLayout
  title="Quality Assurance, Sydney | Wire EDM Pro"
  description="Quality assurance at Wire EDM Pro, Sydney: optical profile projectors, calibrated metrology instruments, first-article and batch inspection on every job."
  ogImage="/images/qc-wireedm.jpg"
  ogImageAlt="Optical profile projector inspecting a machined component at Wire EDM Pro, Sydney"
>
  <section class="qa section--tight">
    <div class="qa__bg" aria-hidden="true">
      <img
        src="/images/qc-wireedm.jpg"
        srcset="/images/qc-wireedm-800.jpg 800w, /images/qc-wireedm.jpg 1600w"
        sizes="(max-width: 56rem) 100vw, 62vw"
        width="1600" height="900"
        alt=""
        fetchpriority="high"
      />
    </div>
    <div class="container qa__copy">
      <p class="qa__kicker mono">Solutions · Quality Assurance</p>
      <h1>Measured before it leaves.</h1>
      <p class="qa__lede">
        A tolerance you can't verify is a guess. Quality is built into every stage of
        production, from initial setup to final packaging: experienced inspectors check
        every job against its approved design before delivery, on calibrated metrology
        instruments maintained for exactly that purpose.
      </p>
    </div>
  </section>

  <section class="section section--panel">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>The inspection equipment <span class="section-head__sub">What checks your part before you see it</span></h2>
      </div>
      <table class="qa__sheet">
        <caption class="visually-hidden">Quality control equipment and what each verifies</caption>
        <thead>
          <tr><th scope="col">Instrument</th><th scope="col">What it verifies</th></tr>
        </thead>
        <tbody>
          {equipment.map((e) => (
            <tr>
              <th scope="row">{e.name}</th>
              <td>{e.verifies}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>What gets checked <span class="section-head__sub">First article · every dimension · every batch</span></h2>
      </div>
      <div class="qa__checks">
        {checks.map((c, i) => (
          <div class="qa__check" data-reveal style={`--reveal-i: ${i}`}>
            <h3>{c.name}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Need documented inspection?"
    body="Tell us on the drawing or at quote. Inspection reports for critical dimensions can be supplied with the delivered part."
  />
</BaseLayout>

<style is:global>
  /* Solutions pages: white hero banner; the sections after it keep the
     palette's light blue tints (client request) */
  body { background: var(--color-paper-2); }
  main > .qa { background: #ffffff; border-bottom: var(--rule-hairline); }
  main > .section:not(.section--panel) { background: var(--color-paper); }
</style>


<style>
  .qa { padding-block: var(--space-2xl); }
  .qa__kicker {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }
  .qa h1 { font-size: var(--text-display-s); max-width: 20ch; }
  .qa__lede {
    margin-top: var(--space-lg);
    font-size: var(--text-md);
    color: var(--color-muted);
    max-width: 56ch;
  }
  .qa__sheet {
    width: 100%;
    border-collapse: collapse;
  }
  .qa__sheet th, .qa__sheet td {
    text-align: left;
    padding: var(--space-sm) var(--space-lg) var(--space-sm) 0;
    border-bottom: var(--rule-hairline);
    vertical-align: top;
  }
  .qa__sheet thead th {
    font-family: var(--font-outlier);
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .qa__sheet tbody th {
    font-family: var(--font-display);
    font-weight: 600;
    width: 20rem;
  }
  .qa__sheet td { color: var(--color-muted); }
  .qa__checks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xl);
  }
  .qa__check h3 {
    font-size: var(--text-lg);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .qa__check h3::before {
    content: "";
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    background: var(--color-accent-bright);
  }
  .qa__check p { margin-top: var(--space-md); color: var(--color-muted); }
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 56rem) {
    .qa__checks { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .qa__sheet tbody th { width: auto; }
  }
  .qa {
    position: relative;
    overflow: hidden;
  }
  /* Banner photo bleeds in from the right and dissolves before the copy */
  .qa__bg {
    position: absolute;
    inset: 0 0 0 auto;
    width: 62%;
  }
  .qa__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to left, rgb(0 0 0) 42%, transparent 97%);
    mask-image: linear-gradient(to left, rgb(0 0 0) 42%, transparent 97%);
  }
  .qa__copy { position: relative; }
  @media (max-width: 56rem) {
    .qa__bg { width: 100%; opacity: 0.22; }
  }
</style>
