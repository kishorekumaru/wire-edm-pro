---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbList } from "../lib/breadcrumbs";
import CtaBand from "../components/CtaBand.astro";
import TurnkeyFlow from "../components/TurnkeyFlow.astro";

const steps = [
  {
    name: "Bring the sample",
    body: "Drop off or send the part. Worn, broken or obsolete is fine. No drawing needed, no CAD file, no documentation.",
  },
  {
    name: "We measure every dimension",
    body: "The part is measured on our inspection equipment: critical fits, profiles, threads and tolerances captured from the physical component.",
  },
  {
    name: "We create the design",
    body: "The measurements become an accurate 3D model (STEP/IGES), a 2D manufacturing drawing and toolpaths in Mastercam. You review and approve the design before anything is cut.",
  },
];

const capabilities = [
  {
    name: "Obsolete part replication",
    body: "Worn-out, broken or legacy parts recreated when the original drawings or the original manufacturer no longer exist.",
  },
  {
    name: "Design optimisation",
    body: "While the part is on the bench we can improve it: material efficiency, structural strength or manufacturability, with your approval on every change.",
  },
  {
    name: "Straight into production",
    body: "Once reversed, the part moves directly into our wire EDM, milling and turning workflows. From a single replacement through to high-volume manufacture.",
  },
];

const breadcrumbs = breadcrumbList([{ name: "Reverse Engineering", href: "/reverse-engineering/" }], Astro.site);
---
<BaseLayout
  title="Reverse Engineering, Sydney | Wire EDM Pro"
  description="No drawing? Bring the part. Wire EDM Pro in Sydney measures your sample, models it in Mastercam and manufactures the replacement, design to delivery."
  jsonLd={breadcrumbs}
  ogImage="/images/reverse-engineering-banner.jpg"
  ogImageAlt="Reverse engineering a sample part at Wire EDM Pro, Sydney"
>
  <section class="re section--tight">
    <div class="re__bg">
      <picture>
              <source srcset="/images/reverse-engineering-banner-800.webp 800w, /images/reverse-engineering-banner.webp 1600w" sizes="(max-width: 56rem) 100vw, 62vw" type="image/webp" />
              <img
        src="/images/reverse-engineering-banner.jpg"
        srcset="/images/reverse-engineering-banner-800.jpg 800w, /images/reverse-engineering-banner.jpg 1600w"
        sizes="(max-width: 56rem) 100vw, 62vw"
        width="1600" height="900"
        alt="Worn component measured for reverse engineering at Wire EDM Pro, Sydney"
        fetchpriority="high"
      />
            </picture>
    </div>
    <div class="container re__copy">
      <p class="re__kicker mono">Solutions · Reverse Engineering</p>
      <h1>No drawing? Bring the part.</h1>
      <p class="re__lede">
        Obsolete spares, worn components, parts whose supplier disappeared decades ago.
        We measure the sample, rebuild the design, and manufacture the replacement.
        The drawing you never had comes back with the part.
      </p>
    </div>
  </section>

  <section class="section section--panel">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Sample to spec <span class="section-head__sub">Three steps from physical part to approved design</span></h2>
      </div>
      <div class="re__steps">
        {steps.map((s, i) => (
          <div class="re__step" data-reveal style={`--reveal-i: ${i}`}>
            <span class="re__num mono">{String(i + 1).padStart(2, "0")}</span>
            <h3>{s.name}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
      <div class="re__caps">
        {capabilities.map((c, i) => (
          <div class="re__cap" data-reveal style={`--reveal-i: ${i}`}>
            <h3>{c.name}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
      <p class="re__note" data-reveal>
        From the approved design onward, the job runs through the same turnkey lifecycle as
        every other part we make:
      </p>
    </div>
  </section>

  <TurnkeyFlow
    heading="Then turnkey to delivery"
    sub="The approved design runs the full lifecycle. Quick turnaround."
  />

  <CtaBand
    heading="Got the part but not the drawing?"
    body="Send a photo of the component to start, or drop the sample at our door. We'll tell you the same day whether we can rebuild it."
  />
</BaseLayout>

<style is:global>
  /* Solutions pages: white hero banner; the sections after it keep the
     palette's light blue tints (client request) */
  body { background: var(--color-paper-2); }
  main > .re { background: #ffffff; border-bottom: var(--rule-hairline); }
  main > .section:not(.section--panel) { background: var(--color-paper); }
</style>


<style>
  .re { padding-block: var(--space-2xl); }
  .re__kicker {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }
  .re h1 { font-size: var(--text-display-s); max-width: 20ch; }
  .re__lede {
    margin-top: var(--space-lg);
    font-size: var(--text-md);
    color: var(--color-muted);
    max-width: 58ch;
  }
  .re__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xl);
  }
  .re__step {
    padding-top: var(--space-md);
    border-top: 2px solid var(--color-rule);
    position: relative;
  }
  .re__step::before {
    content: "";
    position: absolute;
    top: -2px;
    left: 0;
    width: 2rem;
    height: 2px;
    background: var(--color-accent-bright);
  }
  .re__num {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-xs);
  }
  .re__step h3 { font-size: var(--text-md); }
  .re__step p { margin-top: var(--space-xs); color: var(--color-muted); }
  .re__caps {
    margin-top: var(--space-2xl);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xl);
  }
  .re__cap h3 {
    font-size: var(--text-md);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .re__cap h3::before {
    content: "";
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    background: var(--color-accent-bright);
  }
  .re__cap p { margin-top: var(--space-sm); color: var(--color-muted); }
  .re__note {
    margin-top: var(--space-2xl);
    color: var(--color-muted);
    max-width: 56ch;
  }
  @media (max-width: 56rem) {
    .re__steps { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
    .re__caps { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
  }
  .re {
    position: relative;
    overflow: hidden;
  }
  /* Banner photo bleeds in from the right and dissolves before the copy */
  .re__bg {
    position: absolute;
    inset: 0 0 0 auto;
    width: 62%;
  }
  .re__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to left, rgb(0 0 0) 42%, transparent 97%);
    mask-image: linear-gradient(to left, rgb(0 0 0) 42%, transparent 97%);
  }
  .re__copy { position: relative; }
  @media (max-width: 56rem) {
    .re__bg { width: 100%; opacity: 0.22; }
  }
</style>
