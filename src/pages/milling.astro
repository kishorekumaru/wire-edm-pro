---
import ServicePage from "../components/ServicePage.astro";

const specs = [
  { name: "Work envelope", value: "600 × 560 × 510 mm", note: "X / Y / Z travel on the DMG MORI ecoMill 600 V" },
  { name: "Spindle", value: "12,000 rpm", note: "high-speed spindle with Siemens SlimLine control" },
  { name: "Table load", value: "to 600 kg", note: "heavy workpieces stay rigid through the cut" },
  { name: "Tool changer", value: "30 stations", note: "continuous machining with minimal setup lag" },
  { name: "General tolerance", value: "±0.01 mm", note: "typical on critical milled features" },
  { name: "Batch size", value: "1 – repeat production", note: "prototypes, spares and scheduled high-volume batches" },
  { name: "Materials", value: "steels, stainless, alloys", note: "aluminium, engineering plastics, copper, carbon steel, titanium and hardened alloys" },
  { name: "Finishing", value: "in-house EDM follow-up", note: "hardened features finished by wire or spark erosion after milling" },
];

const applications = [
  {
    name: "Jigs, fixtures & tooling plates",
    body: "Location faces, dowel patterns and clamping details machined square and to position, so your assembly or inspection fixture repeats every time it's loaded.",
  },
  {
    name: "Die sets & mould components",
    body: "Pockets, shoes and bolster work milled soft, then hardened details finished by EDM in the same business. One purchase order, one accountable machinist.",
  },
  {
    name: "Machine spares & one-offs",
    body: "Obsolete or unavailable parts re-made from a sample or a sketch. We reverse-measure, draw and machine replacements that fit the first time.",
  },
];
---
<ServicePage
  title="CNC Milling Solutions, Sydney | Wire EDM Pro"
  description="CNC milling in Sydney: jigs, fixtures, die sets and machine spares in steels, stainless and exotic alloys. One-offs through repeat batches, with in-house EDM finishing."
  heroKicker="CNC milling"
  heroTitle="Milled to drawing. Finished in-house."
  heroImage="/images/ecomill-600v"
  heroImageAlt="DMG MORI ecoMill 600 V vertical machining centre at Wire EDM Pro, Sydney"
  heroLede="Our DMG MORI ecoMill 600 V vertical machining centre carries the general machining that surrounds precision EDM work. Jigs, fixtures, die sets and spares in everything from aluminium to pre-hardened tool steel, from one-off prototypes to high-volume production runs. Because milling and EDM share one business, parts that need both never leave the building."
  specs={specs}
  specNote="Envelope and tolerance depend on part geometry and material; both are confirmed when we quote your drawing."
  applications={applications}
  ctaHeading="One drawing, both processes."
  ctaBody="If your part needs milling and EDM, quote it once. We sequence the operations under one roof."
/>
