---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import HeroGraphic from "../components/HeroGraphic.astro";
import TurnkeyFlow from "../components/TurnkeyFlow.astro";

const services = [
  {
    href: "/wire-edm/",
    name: "EDM Wire Solution",
    body: "A 0.25 mm charged wire erodes hardened metal along a programmed path. Zero cutting force. Corners as tight as the kerf allows.",
    img: "/images/fanuc-robocut-c600ia",
    alt: "Fanuc Robocut α-C600iA wire EDM machine at Wire EDM Pro, Sydney",
  },
  {
    href: "/edm-cutting/",
    name: "EDM Cutting Solution",
    body: "Spark erosion reaches what tooling can't: hardened dies, splines, keyways and fine detail. After heat treatment, not before.",
    img: "/images/fanuc-robocut-0id",
    alt: "Fanuc Robocut α-0iD wire EDM machine at Wire EDM Pro, Sydney",
  },
  {
    href: "/milling/",
    name: "CNC milling",
    body: "Multi-axis milled fixtures, die sets and components. One-off prototypes to repeat batches, machined to drawing, not to \"near enough\".",
    img: "/images/cnc-milling",
    alt: "ecoMill 600 V machining centre milling a fixture plate under coolant",
  },
  {
    href: "/turning/",
    name: "CNC turning",
    body: "Shafts, bushes, pins and threads in steels, stainless and exotic alloys. Single-point threaded to gauge. Mating parts assemble by hand.",
    img: "/images/cnc-turning",
    alt: "CNC lathe turning a steel shaft in the chuck, chips flying at the insert",
  },
];

const industries = [
  {
    name: "Manufacturing",
    body: "Press tools, dies, jigs and fixtures that keep production lines running. We machine the tooling your tooling depends on. And we understand that a late die is a stopped line.",
  },
  {
    name: "Mining",
    body: "Wear parts, drive components and repairs in hardened and abrasion-resistant steels. Wire EDM cuts material that has already been through heat treatment, so critical spares don't wait on soft-state machining.",
  },
  {
    name: "Medical",
    body: "Small, exact components in stainless and titanium where surface finish and burr-free edges are not negotiable. EDM leaves no tool pressure and no work hardening on delicate features.",
  },
];
---
<BaseLayout
  title="Wire EDM Pro | Precision Wire EDM & CNC Machining, Sydney"
  description="Sydney precision machining for more than 25 years: wire EDM, wire cutting, EDM cutting, CNC milling and CNC turning for manufacturing, mining and medical industries."
>
  <!-- Hero: full-width animated canvas behind, copy on top -->
  <section class="hero">
    <HeroGraphic />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="container hero__content">
      <div class="hero__copy">
        <p class="hero__kicker mono reveal" style="--i: 0">Australian owned &amp; operated · Sydney · est. early 2000s</p>
        <h1 class="reveal" style="--i: 0"><span class="hero__brand"><span class="hero__brand-wire">WIRE</span> <span class="hero__brand-edm">EDM</span> <span class="hero__brand-pro">PRO</span></span> cuts hardened steel to <span class="hero__accent">five&nbsp;microns</span>.</h1>
        <p class="hero__trust reveal" style="--i: 1">Trusted by Australian industry for 25 years.</p>
        <p class="hero__lede reveal" style="--i: 1">
          A local Sydney workshop machining tool steel, titanium and hardened dies for the
          country's manufacturing, mining and medical businesses. The most demanding,
          high-end precision jobs. Machined to drawing, without compromise.
        </p>
        <div class="hero__actions reveal" style="--i: 2">
          <a class="btn btn--fill" href="/contact/">Get in touch</a>
          <a class="hero__textlink" href="/wire-edm/">View services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Process facts. Not marketing numbers -->
  <section class="stats section--tight" aria-label="Wire EDM process facts">
    <div class="container">
      <dl class="stats__strip tnum">
        <div class="stats__item" data-reveal style="--reveal-i: 0">
          <dt>Positional tolerance</dt>
          <dd class="mono" data-count="0.005" data-decimals="3" data-prefix="±" data-suffix="&#8199;mm">±0.005&nbsp;mm</dd>
        </div>
        <div class="stats__item" data-reveal style="--reveal-i: 1">
          <dt>Maximum part size</dt>
          <dd class="mono" data-count="420" data-suffix="&#8199;mm">420&nbsp;mm</dd>
        </div>
        <div class="stats__item" data-reveal style="--reveal-i: 2">
          <dt>Cutting force on the part</dt>
          <dd class="mono">0&nbsp;N</dd>
        </div>
        <div class="stats__item" data-reveal style="--reveal-i: 3">
          <dt>Machining in Sydney</dt>
          <dd class="mono" data-count="25" data-suffix="+&#8199;years">25+&nbsp;years</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Services. Alternating splits on a blueprint-tinted panel -->
  <section class="section proc-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Four processes <span class="section-head__sub">One workshop. No brokering. No freight between shops.</span></h2>
      </div>
      <div class="proc">
        {services.map((s, i) => (
          <a class="proc__row" href={s.href} data-reveal style={`--reveal-i: ${i % 2}`}>
            <div class="proc__figure">
              <img
                class="proc__img"
                src={`${s.img}-800.jpg`}
                srcset={`${s.img}-800.jpg 800w, ${s.img}.jpg 1600w`}
                sizes="(max-width: 56rem) 100vw, 42vw"
                width="800" height="450"
                alt={s.alt}
                loading="lazy"
              />
            </div>
            <div class="proc__text">
              <h3>{s.name}</h3>
              <p>{s.body}</p>
              <span class="proc__more" aria-hidden="true">View capability →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Turnkey lifecycle -->
  <TurnkeyFlow />

  <!-- Credibility. Workshop photos, partnership tone -->
  <section class="section cred">
    <div class="container">
      <div class="cred__copy" data-reveal>
        <h2>Twenty-five years of saying what we can hold. And holding it.</h2>
        <p class="cred__body">
          Wire EDM Pro has run from Sydney since the early&nbsp;2000s. The machines have changed;
          the discipline hasn't: we quote from real information, we flag risk before the wire
          touches the work, and we answer the phone while your job is on the machine. Most of
          our work arrives from customers who have been sending drawings for a decade or more.
          Because the part that comes back matches the drawing that went in.
        </p>
        <ul class="cred__machines">
          <li>Fanuc Robocut α-C600<span class="mono">i</span>A wire EDM</li>
          <li>Fanuc Robocut α-0<span class="mono">i</span>D wire EDM</li>
          <li>Makino U-series wire EDM</li>
          <li>DMG ecoMill 600&nbsp;V machining centre</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="section industries-section">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2>Built for hard industries <span class="section-head__sub">Manufacturing · Mining · Medical</span></h2>
        <p>Three sectors account for most of what leaves this workshop. <a href="/industries/">See all the industries we serve</a>.</p>
      </div>
      <div class="industries">
        {industries.map((it, i) => (
          <div class="industries__item" data-reveal style={`--reveal-i: ${i}`}>
            <h3>{it.name}</h3>
            <p>{it.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - 65px); /* full screen below the nav */
    display: flex;
    align-items: center;
    padding-block: var(--space-2xl);
    overflow: hidden;
    /* Dusk Blue on the left, easing to Steel Blue on the right. All blue, no white */
    background: linear-gradient(100deg,
      oklch(25.6% 0.067 270) 0%,
      oklch(31.9% 0.063 267) 38%,
      oklch(37.3% 0.081 259) 72%,
      oklch(46% 0.085 255) 100%);
  }
  .hero .container { width: 100%; }
  .hero__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: none; /* the hero gradient itself carries the tone */
  }
  .hero__content { position: relative; }
  .hero__kicker {
    font-size: var(--text-sm);
    color: var(--color-accent-soft);
    margin-bottom: var(--space-md);
  }
  .hero__copy { max-width: 60ch; }
  .hero__copy h1 {
    font-size: var(--text-display-s); /* hero headline deliberately a step down */
    max-width: 18ch;
    color: #ffffff;
  }
  .hero__accent { color: var(--color-accent-soft); }
  /* Wordmark treatment: heavy caps in the logo's three tones, lightened for the dark hero */
  .hero__brand {
    font-family: "Rajdhani", var(--font-display);
    font-weight: 700;
    letter-spacing: -0.005em;
    font-size: 1.12em; /* Rajdhani runs narrow; nudge up to sit level with Open Sans */
    white-space: nowrap;
  }
  /* Exact logo colors, client-supplied. The letters are darker than the hero,
     so a thin white outline plus a soft halo separates them from the background */
  .hero__brand span,
  .hero__brand-wire, .hero__brand-edm, .hero__brand-pro {
    -webkit-text-stroke: 3px rgba(255, 255, 255, 0.92);
    paint-order: stroke fill;
  }
  .hero__brand-wire { color: #2c3d5f; }
  .hero__brand-edm { color: #562d73; }
  .hero__brand-pro { color: #646464; }
  .hero__trust {
    margin-top: var(--space-lg);
    font-size: var(--text-md);
    font-weight: 700;
    letter-spacing: 0.01em;
    color: #ffffff;
    border-left: 3px solid var(--color-accent-soft);
    padding-left: var(--space-sm);
  }
  .hero__lede {
    margin-top: var(--space-md);
    font-size: var(--text-md);
    color: var(--color-on-deep);
    max-width: 52ch;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
    margin-top: var(--space-xl);
  }
  .hero__textlink {
    font-family: var(--font-display);
    font-weight: 500;
    color: #ffffff;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 5px;
    white-space: nowrap;
  }
  .hero__textlink:hover { color: var(--color-accent-soft); }

  .stats { border-block: var(--rule-hairline); padding-block: var(--space-lg); }
  /* Figures bold so the mono face renders crisp at this size */
  .stats__item dd { font-weight: 700; }
  .stats__strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-lg);
    margin: 0;
  }
  .stats__item dt {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .stats__item dd {
    margin: var(--space-2xs) 0 0;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-accent);
  }

  .proc-section { background: #ffffff; }
  /* Rows rise in from the bottom as they scroll into view */
  .proc__row[data-reveal] {
    transform: translateY(72px);
    transition: opacity 700ms var(--ease-out), transform 700ms var(--ease-out);
  }
  .proc__row[data-reveal].is-revealed { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .proc__row[data-reveal] { transform: none; transition: none; }
  }

  /* Four processes: alternating zigzag splits, image and copy swap sides */
  .proc { display: grid; gap: var(--space-2xl); }
  .proc__row {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-2xl);
    align-items: center;
    text-decoration: none;
    color: inherit;
  }
  .proc__row:nth-child(even) .proc__figure { order: 2; }
  .proc__row:nth-child(even) .proc__text { order: 1; }
  .proc__text h3 { font-size: var(--text-xl); transition: color 300ms var(--ease-out); }
  .proc__row:hover .proc__text h3 { color: var(--color-accent); }
  .proc__text p { margin-top: var(--space-sm); color: var(--color-muted); max-width: 52ch; }
  .proc__more {
    display: inline-block;
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-accent);
    white-space: nowrap;
    transition: transform 220ms var(--ease-out);
  }
  .proc__row:hover .proc__more { transform: translateX(6px); }
  .proc__figure {
    overflow: hidden; /* contains the image zoom */
    border-radius: var(--radius-md);
    aspect-ratio: 16 / 9;
  }
  /* Image oversized inside its mask; --py (set on scroll) drifts it for a
     parallax depth effect. Hover still adds the zoom, nothing else moves */
  .proc__img {
    width: 100%;
    height: 122%;
    margin-top: -11%;
    object-fit: cover;
    will-change: transform;
    transform: translate3d(0, var(--py, 0px), 0);
    transition: transform 120ms linear;
  }
  .proc__row:hover .proc__img {
    transform: translate3d(0, var(--py, 0px), 0) scale(1.06);
    transition: transform 700ms var(--ease-out);
  }
  @media (prefers-reduced-motion: reduce) {
    .proc__img { will-change: auto; height: 100%; margin-top: 0; transform: none; }
    .proc__row:hover .proc__img { transform: none; }
  }

  /* Full-bleed machine-floor photo behind an indigo scrim; copy sits on the solid side */
  .cred {
    background-image:
      linear-gradient(90deg,
        oklch(31.9% 0.063 267 / 0.96) 0%,
        oklch(31.9% 0.063 267 / 0.82) 44%,
        oklch(31.9% 0.063 267 / 0.20) 100%),
      url("/images/wire-edm-office.jpg");
    background-size: cover;
    background-position: center right;
    min-height: 34rem;
    display: flex;
    align-items: center;
  }
  .cred .container { width: 100%; }
  .cred__copy { max-width: 56ch; }
  .cred h2 { font-size: var(--text-xl); max-width: 26ch; color: #ffffff; }
  .cred__body { margin-top: var(--space-lg); color: #ffffff; max-width: 56ch; }
  .cred__machines {
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-xs);
  }
  .cred__machines li {
    padding-left: var(--space-lg);
    position: relative;
    font-weight: 500;
    color: #ffffff;
  }
  .cred__machines li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.55rem;
    height: 2px;
    background: var(--color-accent-soft);
  }

  .industries-section { background: #ffffff; }
  .industries {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2xl);
  }
  .industries__item h3 {
    font-size: var(--text-lg);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .industries__item h3::before {
    content: "";
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    background: var(--color-accent-bright);
  }
  .industries__item p {
    margin-top: var(--space-md);
    color: var(--color-muted);
  }

  @media (max-width: 68rem) {
    /* Stacked hero: copy on top, 3D prop below it */
    .hero { align-items: flex-start; min-height: calc(100svh - 65px); }
    .hero__content { padding-top: var(--space-xl); padding-bottom: min(24rem, 78vw); }
  }
  @media (max-width: 56rem) {
    .hero__scrim {
      background: none;
    }
    .cred {
      background-image:
        linear-gradient(oklch(31.9% 0.063 267 / 0.93), oklch(31.9% 0.063 267 / 0.93)),
        url("/images/wire-edm-office.jpg");
      min-height: 0;
    }
    .stats__strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proc__row { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
    .proc__row:nth-child(even) .proc__figure { order: 0; }
    .proc__row:nth-child(even) .proc__text { order: 0; }
    .industries { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
  }
  @media (min-width: 56rem) and (max-width: 80rem) {
    .proc__row { gap: var(--space-xl); }
  }
</style>

<script>
  // Count-up stat numerals on first view (template-inspired), reduced-motion aware
  // Parallax drift on the process photos: each image slides subtly against
  // the scroll while its row crosses the viewport
  {
    const imgs = Array.from(document.querySelectorAll(".proc__img"));
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (imgs.length && !still) {
      let raf = 0;
      const update = () => {
        raf = 0;
        const vh = window.innerHeight;
        for (const img of imgs) {
          const host = img.parentElement;
          if (!host) continue;
          const r = host.getBoundingClientRect();
          if (r.bottom < -120 || r.top > vh + 120) continue;
          const progress = (r.top + r.height / 2 - vh / 2) / vh; // ~-0.7 .. 0.7
          (img as HTMLElement).style.setProperty("--py", `${(progress * -34).toFixed(1)}px`);
        }
      };
      window.addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
      window.addEventListener("resize", () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
      update();
    }
  }

  const dds = document.querySelectorAll(".stats__item dd[data-count]");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (dds.length && !still && "IntersectionObserver" in window) {
    const animate = (el) => {
      const target = parseFloat(el.dataset.count ?? "0");
      const decimals = parseInt(el.dataset.decimals ?? "0", 10);
      const prefix = el.dataset.prefix ?? "";
      const suffix = el.dataset.suffix ?? "";
      const dur = 1200;
      const t0 = performance.now();
      const tick = (t) => {
        const p = Math.min(1, (t - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = `${prefix}${(target * eased).toFixed(decimals)}${suffix}`;
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          animate(e.target);
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.4 });
    dds.forEach((el) => io.observe(el));
  }
</script>
