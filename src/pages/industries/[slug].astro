---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { industries } from "../../data/industries";

export function getStaticPaths() {
  return industries.map((ind) => ({ params: { slug: ind.slug }, props: { ind } }));
}

const { ind } = Astro.props;

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Industries",
      item: new URL("/industries/", Astro.site).href,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: ind.name,
      item: new URL(`/industries/${ind.slug}/`, Astro.site).href,
    },
  ],
};

const services = [
  { href: "/edm-wire-cutting/", name: "EDM Wire Cutting Solution", note: "±0.003 mm profiles in hardened metal, zero cutting force" },
  { href: "/milling/", name: "CNC milling", note: "jigs, fixtures, die sets and machined details" },
  { href: "/turning/", name: "CNC turning", note: "shafts, bushes, pins and threaded components" },
  { href: "/edm-drills/", name: "EDM Drills", note: "small hole EDM from Ø 0.3 mm, burr-free" },
];
---
<BaseLayout
  title={`${ind.name} Machining | Wire EDM Pro, Sydney`}
  description={`${ind.short}. EDM wire cutting, CNC milling and turning for ${ind.name.toLowerCase()}, from our Sydney business.`}
  jsonLd={breadcrumbs}
>
  <section class="ind section--tight" id="ind-hero">
    <div class="container ind__wrap">
      <div>
        <p class="ind__kicker mono"><a href="/industries/">Industries</a> · {ind.name}</p>
        <h1>{ind.name}</h1>
        <p class="ind__lede">{ind.lede}</p>
      </div>
      <div class="ind__badge" id="ind-badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={ind.icon} />
      </div>
    </div>
  </section>

  <section class="section section--panel">
    <div class="container ind__grid">
      <div>
        <h2>What we machine</h2>
        <ul class="ind__list">
          {ind.machined.map((m) => <li>{m}</li>)}
        </ul>
      </div>
      <div>
        <h2>Why the process fits</h2>
        <p class="ind__fit">{ind.fit}</p>
        <div class="ind__services">
          {services.map((s) => (
            <a class="ind__service" href={s.href}>
              <b>{s.name}</b>
              <span>{s.note}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Send us the drawing."
    body={`We quote ${ind.name.toLowerCase()} work from real information. A drawing, STEP file or the worn part itself. And reply within one business day.`}
  />
</BaseLayout>

<style is:global>
  /* Industries pages: white hero banner, matching the solutions pages */
  body { background: var(--color-paper-2); }
  main > .ind { background: #ffffff; border-bottom: var(--rule-hairline); }
  main > .section:not(.section--panel) { background: var(--color-paper); }
</style>


<style>
  .ind {
    padding-block: calc(var(--space-3xl) + var(--space-md));
    overflow: hidden;
  }
  .ind__wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-2xl);
    align-items: center;
  }
  /* Stacked-plate "3D border" tile carrying the industry icon; JS nudges
     --bx/--by from mouse position for a light parallax tilt */
  .ind__badge {
    width: clamp(9rem, 14vw, 12rem);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    color: var(--color-accent);
    background: #ffffff;
    border: 1.5px solid var(--color-accent);
    border-radius: var(--radius-md);
    position: relative;
    margin-right: var(--space-xl);
    transform: translate(calc(var(--bx, 0) * 10px), calc(var(--by, 0) * 8px))
               rotateX(calc(var(--by, 0) * -6deg)) rotateY(calc(var(--bx, 0) * 8deg));
    transform-style: preserve-3d;
    transition: transform 180ms var(--ease-out);
    will-change: transform;
  }
  .ind__badge::before,
  .ind__badge::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
    z-index: -1;
  }
  .ind__badge::before {
    border: 1.5px solid var(--color-accent-soft);
    transform: translate(0.55rem, 0.55rem);
  }
  .ind__badge::after {
    border: 1.5px solid var(--color-rule);
    transform: translate(1.1rem, 1.1rem);
  }
  .ind__badge svg {
    width: 52%;
    height: 52%;
    transform: translateZ(18px);
  }
  @media (max-width: 56rem) {
    .ind__wrap { grid-template-columns: minmax(0, 1fr); }
    .ind__badge { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ind__badge { transform: none !important; transition: none; }
  }
  .ind__kicker {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }
  .ind__kicker a {
    color: var(--color-muted);
    text-decoration: none;
  }
  .ind__kicker a:hover { color: var(--color-accent); }
  .ind h1 { font-size: var(--text-display-s); max-width: 20ch; }
  .ind__lede {
    margin-top: var(--space-lg);
    font-size: var(--text-md);
    color: var(--color-muted);
    max-width: 58ch;
  }

  .ind__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  .ind__grid h2 { font-size: var(--text-lg); }
  .ind__list {
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }
  .ind__list li {
    padding: var(--space-sm) 0 var(--space-sm) var(--space-lg);
    border-bottom: var(--rule-hairline);
    position: relative;
  }
  .ind__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.15em;
    width: 0.55rem;
    height: 2px;
    background: var(--color-accent);
  }
  .ind__fit { margin-top: var(--space-lg); color: var(--color-muted); max-width: 52ch; }
  .ind__services {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-sm);
  }
  .ind__service {
    display: grid;
    gap: 0.15rem;
    padding: var(--space-md) var(--space-lg);
    background: var(--color-paper);
    border: var(--rule-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--dur-short) var(--ease-out);
  }
  .ind__service:hover { border-color: var(--color-accent); }
  .ind__service b { font-family: var(--font-display); color: var(--color-ink); }
  .ind__service span { font-size: var(--text-sm); color: var(--color-muted); }

  @media (max-width: 56rem) {
    .ind__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-xl); }
  }
</style>

<script>
  // Light mouse parallax on the hero badge
  const hero = document.getElementById("ind-hero");
  const badge = document.getElementById("ind-badge");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (hero && badge && fine && !still) {
    let raf = 0, nx = 0, ny = 0;
    const apply = () => {
      raf = 0;
      badge.style.setProperty("--bx", nx.toFixed(3));
      badge.style.setProperty("--by", ny.toFixed(3));
    };
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      nx = ((e.clientX - r.left) / r.width) * 2 - 1;
      ny = ((e.clientY - r.top) / r.height) * 2 - 1;
      if (!raf) raf = requestAnimationFrame(apply);
    });
    hero.addEventListener("pointerleave", () => {
      nx = 0; ny = 0;
      if (!raf) raf = requestAnimationFrame(apply);
    });
  }
</script>
