---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBand from "../../components/CtaBand.astro";
import { industries } from "../../data/industries";
---
<BaseLayout
  title="Industries We Serve | Wire EDM Pro, Sydney"
  description="Precision machining solutions for every industry: tooling and diemaking, aerospace, medical, mining, automotive, electronics, energy, machine building, robotics and general engineering."
>
  <section class="ind-hub section--tight">
    <div class="container">
      <p class="ind-hub__kicker mono">Industries</p>
      <h1>Solutions for every industry.</h1>
      <p class="ind-hub__lede">
        The processes are the same. Wire EDM, EDM cutting, CNC milling and turning. What changes
        is what each industry asks of them. Pick yours to see the parts we machine and why the
        process fits.
      </p>

      <div class="ind-hub__grid">
        {industries.map((ind) => (
          <a class="ind-hub__card" href={`/industries/${ind.slug}/`}>
            <h2>{ind.name}</h2>
            <p>{ind.short}</p>
            <span class="ind-hub__more" aria-hidden="true">View industry →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand
    heading="Industry not listed?"
    body="If the part is metal and the drawing is exact, it's probably our kind of work. Send it through and we'll tell you straight."
  />
</BaseLayout>

<style>
  .ind-hub { padding-block: var(--space-2xl) var(--space-3xl); }
  .ind-hub__kicker {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }
  .ind-hub h1 { font-size: var(--text-display-s); }
  .ind-hub__lede {
    margin-top: var(--space-md);
    font-size: var(--text-md);
    color: var(--color-muted);
    max-width: 56ch;
  }
  .ind-hub__grid {
    margin-top: var(--space-2xl);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: var(--space-lg);
  }
  .ind-hub__card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background: var(--color-paper);
    border: var(--rule-hairline);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur-short) var(--ease-out);
  }
  .ind-hub__card:hover { border-color: var(--color-accent); }
  .ind-hub__card h2 { font-size: var(--text-md); }
  .ind-hub__card p { margin-top: var(--space-xs); font-size: var(--text-sm); color: var(--color-muted); flex: 1; }
  .ind-hub__more {
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-accent);
    white-space: nowrap;
  }
</style>
