---
/**
 * Temporary holding page. The real home page lives at /landing/ while the
 * site is finished; swap this file out (and move landing.astro back to
 * index.astro) at launch.
 */
import "../styles/global.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Wire EDM Pro | Coming Soon</title>
    <meta name="description" content="Wire EDM Pro, Sydney precision machining. Our new website is on its way." />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="cs">
    <main class="cs__main">
      <img class="cs__logo" src="/images/wire-edm-high-res.png" alt="Wire EDM Pro" width="210" height="72" />
      <p class="cs__kicker mono">Sydney · precision machining · est. early 2000s</p>
      <h1>Coming soon.</h1>
      <p class="cs__lede">
        Our new website is being finished. The workshop, as always, is open.
        Wire EDM, CNC milling and turning, quoted from your drawing.
      </p>
      <div class="cs__contact mono">
        <a href="tel:+61452558052">0452 558 052</a>
        <span aria-hidden="true">·</span>
        <a href="mailto:wireedmpro@gmail.com">wireedmpro@gmail.com</a>
      </div>
    </main>
    <style>
      .cs {
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: var(--space-xl);
      }
      .cs__main { max-width: 40rem; }
      .cs__logo {
        height: 72px;
        width: auto;
        margin-inline: auto;
      }
      .cs__kicker {
        margin-top: var(--space-lg);
        font-size: var(--text-sm);
        color: var(--color-muted);
      }
      .cs h1 {
        margin-top: var(--space-sm);
        font-size: var(--text-display-s);
      }
      .cs__lede {
        margin: var(--space-lg) auto 0;
        color: var(--color-muted);
        max-width: 44ch;
      }
      .cs__contact {
        margin-top: var(--space-xl);
        display: flex;
        justify-content: center;
        gap: var(--space-sm);
        flex-wrap: wrap;
        font-size: var(--text-sm);
      }
      .cs__contact a {
        color: var(--color-accent);
        text-decoration: none;
      }
      .cs__contact a:hover { color: var(--color-ink); }
      .cs__contact span { color: var(--color-rule); }
    </style>
  </body>
</html>
