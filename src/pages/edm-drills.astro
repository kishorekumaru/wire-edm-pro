---
import ServicePage from "../components/ServicePage.astro";

const specs = [
  { name: "Hole diameter", value: "Ø 0.3–3.0 mm", note: "fast micro-hole drilling across the full range" },
  { name: "Edge condition", value: "burr-free", note: "spark erosion leaves no burr and no exit breakout" },
  { name: "Cutting force", value: "0 N", note: "a rotating tubular electrode erodes the hole. No drill pressure, no wander off a hard surface" },
  { name: "Materials", value: "any conductive metal", note: "tool steel, stainless, titanium, carbide, copper, exotic alloys" },
];

const applications = [
  {
    name: "Start holes for wire EDM",
    body: "A wire cut of an internal profile begins from a threading hole. EDM drilling puts that hole exactly where the program needs it, straight through hardened stock, without annealing the area around it.",
  },
  {
    name: "Cooling channels & vents in dies and moulds",
    body: "Cooling lines, vent holes and ejector-pin clearances drilled into tooling after heat treatment, so the die that leaves heat treat is the die that runs.",
  },
  {
    name: "Small deep holes in hardened parts",
    body: "Where a twist drill would snap, walk or work-harden the bore, the electrode erodes a straight, consistent hole through material at any hardness.",
  },
  {
    name: "Nozzles, orifices & instrumentation features",
    body: "Precise small apertures in valves, nozzles and measurement components, sized and positioned to drawing with clean, burr-free openings.",
  },
];
---
<ServicePage
  title="EDM Drills, Small Hole EDM, Sydney | Wire EDM Pro"
  description="Small hole EDM drilling in Sydney: burr-free holes from Ø 0.3 mm to 3.0 mm in hardened metal. Start holes, cooling channels and vents, drilled after heat treatment."
  heroKicker="EDM Drills"
  heroTitle="Small holes, hard metal, no burrs."
  heroImage="/images/edm-drilling"
  heroImageAlt="EDM drilling machine at Wire EDM Pro, Sydney"
  heroLede="EDM drilling, the trade calls it hole blowing, sinks small holes by spark erosion instead of drill pressure. A rotating tubular electrode erodes through the material while dielectric fluid flushes the gap, so a Ø 0.3 mm hole goes through fully hardened steel straight, round and burr-free. It's how every internal wire-cut profile starts, and how cooling channels get into finished tooling."
  specs={specs}
  specNote="Figures are typical small hole EDM process capability; achievable depth depends on diameter and material. We confirm at quote."
  applications={applications}
  ctaHeading="A hole a drill can't make?"
  ctaBody="Too small, too deep, or into metal too hard. That's what EDM drilling is for. Send the drawing and we'll quote it."
/>
