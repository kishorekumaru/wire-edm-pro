---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "./CtaBand.astro";
import { otherSolutions } from "../data/solutions";
import { industries } from "../data/industries";
import { breadcrumbList } from "../lib/breadcrumbs";

interface Spec {
  name: string;
  value: string;
  note?: string;
}
interface Application {
  name: string;
  body: string;
}
interface Props {
  title: string;
  description: string;
  heroKicker: string;
  heroTitle: string;
  heroLede: string;
  heroImage?: string;
  heroImageAlt?: string;
  /** Plain service name for schema.org and the breadcrumb; the h1 is a slogan. */
  serviceName: string;
  /** Industry slugs this process most often serves, for cross-linking. */
  relatedIndustries?: string[];
  specs: Spec[];
  specNote?: string;
  applications: Application[];
  ctaHeading?: string;
  ctaBody?: string;
}
const {
  title, description, heroKicker, heroTitle, heroLede,
  heroImage, heroImageAlt, serviceName, relatedIndustries = [],
  specs, specNote, applications, ctaHeading, ctaBody,
} = Astro.props;

const related = otherSolutions(Astro.url.pathname);
const relatedInd = relatedIndustries
  .map((slug) => industries.find((i) => i.slug === slug))
  .filter((i): i is NonNullable<typeof i> => Boolean(i));

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: heroKicker,
  name: serviceName,
  description: heroLede,
  url: new URL(Astro.url.pathname, Astro.site).href,
  // Reference the site-wide Organization node instead of declaring a second,
  // unlinked business (see BaseLayout.astro)
  provider: { "@id": new URL("/", Astro.site).href + "#organization" },
  areaServed: "Sydney",
};

const breadcrumbs = breadcrumbList(
  [{ name: serviceName, href: Astro.url.pathname }],
  Astro.site,
);
---
<BaseLayout
  title={title}
  description={description}
  ogImage={heroImage ? `${heroImage}.jpg` : undefined}
  ogImageAlt={heroImage ? heroImageAlt : undefined}
  jsonLd={[serviceSchema, breadcrumbs]}
>
  <section class="svc-hero">
    {heroImage && (
      <div class="svc-hero__bg">
        <picture>
          <source
            srcset={`${heroImage}-800.webp 800w, ${heroImage}.webp 1600w`}
            sizes="(max-width: 56rem) 100vw, 62vw"
            type="image/webp"
          />
          <img
            src={`${heroImage}.jpg`}
            srcset={`${heroImage}-800.jpg 800w, ${heroImage}.jpg 1600w`}
            sizes="(max-width: 56rem) 100vw, 62vw"
            width="1600" height="900"
            alt={heroImageAlt ?? ""}
            fetchpriority="high"
          />
        </picture>
      </div>
    )}
    <div class="container">
      <div class="svc-hero__copy">
        <p class="svc-hero__kicker mono">{heroKicker}</p>
        <h1>{heroTitle}</h1>
        <p class="svc-hero__lede">{heroLede}</p>
        <div class="svc-hero__actions">
          <a class="btn btn--fill" href="/contact/">Get a quote</a>
        </div>
      </div>
    </div>
  </section>

  <slot name="deep" />

  <section class="section section--panel">
    <div class="container">
      <div class="section-head">
        <h2>Capability</h2>
        <p>What this process holds, cuts and finishes.</p>
      </div>
      <table class="spec-sheet tnum">
        <caption class="visually-hidden">{heroTitle}. Capability specification</caption>
        <tbody>
          {specs.map((s) => (
            <tr>
              <th scope="row">{s.name}</th>
              <td class="mono">{s.value}</td>
              <td class="spec-sheet__note">{s.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
      {specNote && <p class="spec-sheet__foot">{specNote}</p>}
    </div>
  </section>

  <section class="section svc-uses">
    <div class="container">
      <div class="section-head">
        <h2>Where it earns its keep</h2>
      </div>
      <div class="apps">
        {applications.map((a) => (
          <div class="apps__row">
            <h3>{a.name}</h3>
            <p>{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section svc-more">
    <div class="container">
      <div class="section-head">
        <h2>The rest of the shop<span class="section-head__sub">One business, quoted and machined here</span></h2>
      </div>
      <ul class="svc-more__list">
        {related.map((s) => (
          <li>
            <a class="svc-more__link" href={s.href}>
              <svg class="svc-more__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} />
              <span>
                <strong>{s.label}</strong>
                <span class="svc-more__note">{s.note}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      {relatedInd.length > 0 && (
        <p class="svc-more__ind">
          Common in{" "}
          {relatedInd.map((ind, i) => (
            <>
              {i > 0 && (i === relatedInd.length - 1 ? " and " : ", ")}
              <a href={`/industries/${ind.slug}/`}>{ind.name.toLowerCase()}</a>
            </>
          ))}
          . <a href="/industries/">See all industries</a>.
        </p>
      )}
    </div>
  </section>

  <CtaBand heading={ctaHeading} body={ctaBody} />
</BaseLayout>

<style is:global>
  /* Solutions pages: white hero banner; the sections after it keep the
     palette's light blue tints (client request) */
  body { background: var(--color-paper-2); }
  main > .svc-hero { background: #ffffff; border-bottom: var(--rule-hairline); }
  main > .section:not(.section--panel):not(.svc-uses) { background: var(--color-paper); }
  /* "Where it earns its keep": a step darker than the panels above it */
  main > .section.svc-uses { background: var(--color-paper-3); }
</style>


<style>
  .svc-hero {
    position: relative;
    overflow: hidden;
    padding-block: var(--space-2xl);
    min-height: 22rem;
  }
  /* Photo bleeds in from the right and dissolves before it reaches the copy */
  .svc-hero__bg {
    position: absolute;
    inset: 0 0 0 auto;
    width: 62%;
  }
  .svc-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask-image: linear-gradient(to left, rgb(0 0 0) 42%, transparent 97%);
    mask-image: linear-gradient(to left, rgb(0 0 0) 42%, transparent 97%);
  }
  .svc-hero__copy {
    position: relative;
    max-width: 44rem;
  }
  .svc-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: center;
  }
  .svc-hero__kicker {
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-bottom: var(--space-md);
  }
  .svc-hero h1 {
    font-size: var(--text-display-s);
    max-width: 20ch;
  }
  .svc-hero__lede {
    margin-top: var(--space-lg);
    font-size: var(--text-md);
    color: var(--color-muted);
    max-width: 58ch;
  }
  .svc-hero__actions { margin-top: var(--space-xl); }

  @media (max-width: 56rem) {
    .svc-hero__grid { grid-template-columns: minmax(0, 1fr); gap: var(--space-lg); }
    .svc-hero__bg { width: 100%; opacity: 0.22; }
  }

  .spec-sheet {
    width: 100%;
    border-collapse: collapse;
  }
  .spec-sheet th, .spec-sheet td {
    text-align: left;
    padding: var(--space-sm) var(--space-lg) var(--space-sm) 0;
    border-bottom: var(--rule-hairline);
    vertical-align: top;
  }
  .spec-sheet th {
    font-family: var(--font-display);
    font-weight: 600;
    width: 14rem;
  }
  .spec-sheet td.mono { white-space: nowrap; }
  .spec-sheet__note { color: var(--color-muted); }
  .spec-sheet__foot {
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .apps__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.5fr);
    gap: var(--space-lg);
    padding-block: var(--space-lg);
    border-top: var(--rule-hairline);
  }
  .apps__row:last-child { border-bottom: var(--rule-hairline); }
  .apps__row h3 { font-size: var(--text-lg); }
  .apps__row p { color: var(--color-muted); }

  .svc-more__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: var(--space-md);
  }
  .svc-more__link {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
    height: 100%;
    padding: var(--space-lg);
    background: var(--color-surface);
    border: var(--rule-hairline);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-short) var(--ease-out),
                transform var(--dur-short) var(--ease-out);
  }
  .svc-more__link:hover {
    border-color: var(--color-accent-bright);
    transform: translateY(-2px);
  }
  .svc-more__icon {
    flex: none;
    width: 24px;
    height: 24px;
    fill: none;
    stroke: var(--color-accent-bright);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .svc-more__link strong {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-base);
  }
  .svc-more__note {
    display: block;
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .svc-more__ind {
    margin-top: var(--space-xl);
    color: var(--color-muted);
    max-width: none;
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 56rem) {
    .apps__row { grid-template-columns: minmax(0, 1fr); gap: var(--space-xs); }
    .spec-sheet__note { display: none; }
    .spec-sheet th { width: auto; }
  }
</style>
