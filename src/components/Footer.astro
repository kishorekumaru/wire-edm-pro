---
const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="container">
    <p class="foot__brand">
      <picture>
        <source srcset="/images/logo-nav-160.webp 1x, /images/logo-nav.webp 2x" type="image/webp" />
        <img src="/images/logo-nav.png" alt="Wire EDM Pro" width="140" height="48" loading="lazy" />
      </picture>
    </p>
    <p class="foot__tagline">Precision machining in Sydney for more than 25&nbsp;years. EDM wire cutting, EDM drilling, CNC milling and CNC turning for manufacturing, mining and medical work.</p>
    <nav class="foot__links" aria-label="Footer">
      <a class="foot__link" href="/edm-wire-cutting/">EDM Wire Cutting Solution</a>
      <a class="foot__link" href="/milling/">Milling solutions</a>
      <a class="foot__link" href="/turning/">Turning solutions</a>
      <a class="foot__link" href="/edm-drills/">EDM Drills</a>
      <a class="foot__link" href="/reverse-engineering/">Reverse Engineering</a>
      <a class="foot__link" href="/quality-assurance/">Quality Assurance</a>
      <a class="foot__link" href="/industries/">Industries</a>
      <a class="foot__link" href="/about/">About us</a>
      <a class="foot__link" href="/contact/">Contact us</a>
    </nav>
    <div class="foot__meta">
      <p>16/24 Garling Rd, Kings Park NSW 2148</p>
      <p><a class="foot__meta-link" href="tel:+61286048347">02 8604 8347</a> · <a class="foot__meta-link" href="tel:+61452558052">0452 558 052</a> · <a class="foot__meta-link" href="mailto:wireedmpro@gmail.com">wireedmpro@gmail.com</a></p>
      <p class="foot__copyright">© {year} Wire EDM Pro. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  /* Deep slate-teal band (derived from Juniper's hue). Dark close to the page */
  .foot {
    padding-block: var(--space-2xl) var(--space-xl);
    background: var(--color-deep);
    color: #ffffff;
  }
  /* The logo's navy/purple lettering needs a light plate to read on the dark band */
  .foot__brand { margin: 0; }
  .foot__brand img {
    display: block;
    height: 76px;
    width: auto;
    background: #ffffff;
    padding: 0.65rem 1.1rem;
    border-radius: var(--radius-sm);
  }
  .foot__tagline {
    margin-top: var(--space-sm);
    max-width: 52ch;
    color: #ffffff;
  }
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-lg);
    margin-block: var(--space-lg);
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-deep-2);
  }
  .foot__link {
    font-family: var(--font-display);
    font-weight: 600;
    color: #ffffff;
    text-decoration: none;
    white-space: nowrap;
  }
  .foot__link:hover { color: var(--color-accent-soft); }
  .foot__meta p { color: #ffffff; font-size: var(--text-sm); }
  .foot__meta p + p { margin-top: var(--space-2xs); }
  .foot__meta-link { color: #ffffff; text-decoration: none; }
  .foot__meta-link:hover { color: var(--color-accent-soft); }
  .foot__copyright { margin-top: var(--space-md); }
</style>
