---
/**
 * Light variant of HeroGraphic for the white-background landing (v2):
 * DRO readout, upright XYZ marker and the interactive chrome part sit over a
 * one-point-perspective ground plane, 3ds-max viewport style: depth lines
 * converge on a vanishing point, rows pack harmonically toward the horizon.
 */
const HORIZON = 185; // horizon line, in viewBox units - above the hero's midpoint
const VPX = 1180; // vanishing point x, sitting behind the part
const rows = Array.from({ length: 40 }, (_, i) => HORIZON + 910 / (i + 2));
const spokes = Array.from({ length: 73 }, (_, i) => (i - 36) * 95); // x offset at the bottom edge
---
<div class="hg" id="hero-graphic" aria-hidden="true">
  <svg class="hg__bg" viewBox="0 0 1600 640" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <linearGradient id="hg-fade-v" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0.30" stop-color="#ffffff" stop-opacity="0" />
        <stop offset="0.45" stop-color="#ffffff" stop-opacity="0.5" />
        <stop offset="0.7" stop-color="#ffffff" stop-opacity="1" />
      </linearGradient>
      <linearGradient id="hg-fade-h" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#ffffff" stop-opacity="0" />
        <stop offset="0.28" stop-color="#ffffff" stop-opacity="0.18" />
        <stop offset="0.7" stop-color="#ffffff" stop-opacity="1" />
      </linearGradient>
      <mask id="hg-mask-v"><rect width="1600" height="640" fill="url(#hg-fade-v)" /></mask>
      <mask id="hg-mask-h"><rect width="1600" height="640" fill="url(#hg-fade-h)" /></mask>
    </defs>
    <!-- Perspective floor: strongest bottom-right, fading at the horizon -->
    <g mask="url(#hg-mask-v)">
      <g mask="url(#hg-mask-h)">
        {rows.map((y) => <line x1="0" y1={y} x2="1600" y2={y} class="hg__gridline" />)}
        {spokes.map((dx) => <line x1={VPX} y1={HORIZON} x2={VPX + dx} y2="640" class="hg__gridline" />)}
      </g>
    </g>
  </svg>

  <!-- Axes beside the 3D part: kept upright, outside the tilted floor plane -->
  <svg class="hg__axes" viewBox="0 0 130 120" aria-hidden="true">
    <defs>
      <marker id="hg-arrow2" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M 0 0 L 8 4 L 0 8 z" class="hg__arrowhead" />
      </marker>
    </defs>
    <g opacity="0.6">
      <line x1="60" y1="80" x2="105" y2="103" marker-end="url(#hg-arrow2)" />
      <line x1="60" y1="80" x2="18" y2="102" marker-end="url(#hg-arrow2)" />
      <line x1="60" y1="80" x2="60" y2="17" marker-end="url(#hg-arrow2)" />
      <text x="110" y="114" class="hg__axis-label">X</text>
      <text x="3" y="114" class="hg__axis-label">Y</text>
      <text x="55" y="10" class="hg__axis-label">Z</text>
    </g>
  </svg>

  <!-- DRO-style coordinate readout. HTML overlay so viewBox cropping never hides it -->
  <div class="hg__dro" aria-hidden="true">
    <span id="dro-x">X&#8199;142.500</span>
    <span id="dro-y">Y&#8199;036.250</span>
    <span id="dro-z">Z&#8199;084.000</span>
  </div>

  <div class="hg__stage">
    <div class="hg__part3d" id="hero-part"></div>
    <span class="hg__tag" style="top: 8%; left: -4%;">inner form · ±0.005&nbsp;mm</span>
    <span class="hg__tag" style="top: 48%; right: -8%;">4-axis taper cutting</span>
    <span class="hg__tag" style="bottom: 4%; left: 6%;">cut after hardening</span>
  </div>
</div>

<style>
  .hg {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .hg__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Drift is eased per-frame in the script below; a CSS transition here
       would restart on every pointer event and read as rubber-banding */
    transform: translate(calc(var(--mx, 0) * -10px), calc(var(--my, 0) * -7px));
    will-change: transform;
  }

  /* Blueprint lines inverted for the white hero: ink-blue at low opacity */
  .hg__gridline { stroke: var(--color-accent-bright); stroke-width: 1; stroke-opacity: 0.5; }
  .hg__axes {
    position: absolute;
    top: 64%;
    right: 13.5vw;
    width: 8.5rem;
  }
  .hg__axes line { stroke: var(--color-accent); stroke-width: 1.75; }
  .hg__arrowhead { fill: var(--color-accent); }
  .hg__axis-label {
    font-family: var(--font-outlier);
    font-size: 13px;
    fill: var(--color-accent);
  }
  .hg__dro {
    position: absolute;
    top: var(--space-xl);
    right: var(--page-gutter);
    display: grid;
    gap: 0.2rem;
    justify-items: end;
    font-family: var(--font-outlier);
    font-size: 14px;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .hg__stage {
    position: absolute;
    top: 53%;
    right: max(10vw, calc((100vw - 100rem) / 2 + 6vw));
    transform: translateY(-50%);
    width: clamp(21rem, 36vw, 37rem);
  }
  .hg__part3d {
    position: relative;
    aspect-ratio: 1 / 1.02;
    pointer-events: auto; /* receives touch drags; mouse events bubble to the hero */
  }
  @media (pointer: coarse) {
    .hg__part3d { touch-action: none; } /* drags on the prop rotate it; page scrolls elsewhere */
  }
  .hg__part3d :global(.hg__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 16px 24px oklch(35% 0.04 262 / 0.28));
  }
  .hg__tag {
    position: absolute;
    background: var(--color-paper);
    border: 1px solid var(--color-accent-soft);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    font-family: var(--font-outlier);
    font-size: 13px;
    color: var(--color-accent);
    white-space: nowrap;
    box-shadow: 0 4px 14px -8px oklch(25% 0.06 255 / 0.4);
    opacity: 0;
    transition: opacity var(--dur-long) var(--ease-out);
  }
  .hg__part3d[data-live] ~ .hg__tag { opacity: 1; }

  @media (max-width: 68rem) {
    /* Mobile hero is compact copy-only: no 3D part, no DRO numbers, no axes */
    .hg__stage, .hg__dro, .hg__axes { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hg__bg, .hg__tilt { transform: none !important; transition: none; }
  }
</style>

<script>
  const hg = document.getElementById("hero-graphic");
  const hero = hg?.closest("section");
  const partHost = document.getElementById("hero-part");
  const fine = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Background grid parallax + live DRO readout tracking the pointer.
  // Targets come from pointer events; an rAF loop eases the actual values
  // toward them so the drift stays fluid instead of stepping with the mouse
  if (hg && hero && fine && !still) {
    const droX = document.getElementById("dro-x");
    const droY = document.getElementById("dro-y");
    const droZ = document.getElementById("dro-z");
    const FIGURE_SPACE = " ";
    const fmt = (v: number) => v.toFixed(3).padStart(7, "0");
    let raf = 0;
    let tx = 0, ty = 0; // pointer targets
    let cx = 0, cy = 0; // eased values
    const step = () => {
      cx += (tx - cx) * 0.1;
      cy += (ty - cy) * 0.1;
      hg.style.setProperty("--mx", cx.toFixed(4));
      hg.style.setProperty("--my", cy.toFixed(4));
      // Machine-style coordinates: centre of travel matches the resting values
      // (X 142.500 / Y 036.250 / Z 084.000)
      if (droX) droX.textContent = `X${FIGURE_SPACE}${fmt(((cx + 1) / 2) * 285)}`;
      if (droY) droY.textContent = `Y${FIGURE_SPACE}${fmt(((1 - cy) / 2) * 72.5)}`;
      if (droZ) droZ.textContent = `Z${FIGURE_SPACE}${fmt(((1 - cy) / 2) * 168)}`;
      if (Math.abs(tx - cx) > 0.0005 || Math.abs(ty - cy) > 0.0005) {
        raf = requestAnimationFrame(step);
      } else {
        raf = 0;
      }
    };
    const wake = () => {
      if (!raf) raf = requestAnimationFrame(step);
    };
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width) * 2 - 1;
      ty = ((e.clientY - r.top) / r.height) * 2 - 1;
      wake();
    });
    hero.addEventListener("pointerleave", () => {
      tx = 0;
      ty = 0;
      wake();
    });
  }

  // 3D sample part: lazy-load Three.js only when the hero is near the viewport,
  // and never on small screens where the stage is hidden
  const wide = window.matchMedia("(min-width: 68rem)").matches;
  if (partHost && hero && wide) {
    const load = async () => {
      const { initSamplePart } = await import("../scripts/samplePart3d");
      initSamplePart(partHost, hero, { finish: "chrome" });
    };
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          load();
        }
      },
      { rootMargin: "240px" },
    );
    io.observe(partHost);
  }
</script>
