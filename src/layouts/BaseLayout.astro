---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import {
  ADDRESS,
  BUSINESS_DESCRIPTION,
  EMAIL,
  PHONE_LANDLINE,
  PHONE_MOBILE,
  SAME_AS,
  SITE_NAME,
} from "../data/site";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogImageAlt?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const {
  title,
  description,
  ogImage = "/images/og-default.jpg",
  ogImageAlt = "Wire EDM Pro precision machining, Sydney",
  jsonLd,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const home = new URL("/", Astro.site).href;
const orgId = `${home}#organization`;
const logoUrl = new URL("/images/wire-edm-high-res.png", Astro.site).href;
const postalAddress = { "@type": "PostalAddress", ...ADDRESS };

/**
 * One connected entity graph rather than a floating LocalBusiness node. The
 * Organization is the node other pages reference (see ServicePage.astro), and
 * its sameAs list is what tells Google the domain, the Google Business Profile
 * and the directory listings are all the same company. Without that, a brand
 * name that is also an industry term ("wire EDM") does not resolve to a business.
 */
const entityGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: SITE_NAME,
      url: home,
      description: BUSINESS_DESCRIPTION,
      logo: { "@type": "ImageObject", url: logoUrl, caption: SITE_NAME },
      image: logoUrl,
      telephone: [PHONE_LANDLINE.intl, PHONE_MOBILE.intl],
      email: EMAIL,
      address: postalAddress,
      ...(SAME_AS.length ? { sameAs: SAME_AS } : {}),
    },
    {
      "@type": "LocalBusiness",
      "@id": `${home}#business`,
      name: SITE_NAME,
      url: home,
      description: BUSINESS_DESCRIPTION,
      parentOrganization: { "@id": orgId },
      image: logoUrl,
      telephone: [PHONE_LANDLINE.intl, PHONE_MOBILE.intl],
      email: EMAIL,
      address: postalAddress,
      openingHoursSpecification: [
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday"],
          opens: "08:00",
          closes: "16:30",
        },
        {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: "Friday",
          opens: "08:00",
          closes: "12:00",
        },
      ],
      areaServed: "Sydney",
    },
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: SITE_NAME,
      url: home,
      inLanguage: "en-AU",
      publisher: { "@id": orgId },
    },
  ],
};
const extraJsonLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#172043" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/open-sans-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-var.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wire EDM Pro" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:image" content={ogImageUrl} />
    {ogImage === "/images/og-default.jpg" && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="generator" content={Astro.generator} />
    <script type="application/ld+json" set:html={JSON.stringify(entityGraph)} />
    {extraJsonLd.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}
    <GoogleAnalytics />
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
    <script>
      // One-shot scroll reveals for [data-reveal] elements (template-inspired UX)
      const els = document.querySelectorAll("[data-reveal]");
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!reduced && "IntersectionObserver" in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-revealed");
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-revealed"));
      }
    </script>
  </body>
</html>
